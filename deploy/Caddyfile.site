# The website of a container that is behind the TLS of its host (Back4app and the like: the host terminates https and
# forwards plain http to PORT). It is deploy/Caddyfile without the certificate part: no name, no HTTPS of its own, the api
# on the same container. The headers and the routes are the same as on the VM.
#
# Who the client is: the host puts the address of the visitor in X-Forwarded-For. This Caddy believes that header only from
# a private address (the proxies of a host are inside its network), and the api is told to count two hops
# (API_TRUSTED_PROXY_HOPS=2: this Caddy and the proxy of the host). If the proxy of the host is not on a private address,
# everybody is seen as that one proxy: the failed-login limit is then shared by all visitors, which is the safe way to
# fail (it can lock the owner out for a while, never let a stranger in; `pnpm aiven admin throttle:reset` lifts it).
{
	auto_https off
	admin off
	servers {
		trusted_proxies static private_ranges
		client_ip_headers X-Forwarded-For
	}
}

:{$PORT:8080} {
	encode zstd gzip

	header {
		# the host's own domain: no includeSubDomains for a name that is not ours
		Strict-Transport-Security "max-age=31536000"
		X-Content-Type-Options "nosniff"
		Referrer-Policy "no-referrer"
		Permissions-Policy "accelerometer=(), camera=(), geolocation=(), gyroscope=(), microphone=(), payment=(), usb=()"
		Content-Security-Policy "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; font-src 'self'; connect-src 'self'; worker-src 'self'; manifest-src 'self'; object-src 'none'; base-uri 'self'; form-action 'self'; frame-ancestors 'none'"
		Cross-Origin-Opener-Policy "same-origin"
		-Server
	}

	@api path /api/* /health/*
	handle @api {
		header >Cache-Control "no-store"
		reverse_proxy 127.0.0.1:3000 {
			flush_interval -1
			transport http {
				response_header_timeout 60s
			}
		}
	}

	handle /assets/* {
		root * /srv/web
		@present file
		header @present Cache-Control "public, max-age=31536000, immutable"
		file_server
	}

	handle {
		root * /srv/web
		header Cache-Control "no-cache"
		header /manifest.webmanifest Content-Type "application/manifest+json"
		try_files {path} /index.html
		file_server
	}
}
