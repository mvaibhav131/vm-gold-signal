# VM Gold Signal: the environment of the VM. Copy this file to /opt/vmgs/.env, owned by root, mode 600:
#   sudo install -m 600 -o root -g root /opt/vmgs/deploy/env.example /opt/vmgs/.env && sudo nano /opt/vmgs/.env
# The copy is never committed and never pasted into a chat. Every password below is made with:  openssl rand -hex 24
# (letters and digits only: they go into URLs). Empty values count as not set.

# --- the host -------------------------------------------------------------------------------------------------
# The DuckDNS name (B31b serves the web app on it). The worker needs it too.
PUBLIC_HOST=vmgs-yourname.duckdns.org
# Image tag: deploy.sh exports the release it deploys and, after a good smoke test, writes it to /opt/vmgs/.version, which
# compose.sh reads. Leave it out here (default: local, for a PC).
#VMGS_VERSION=
LOG_LEVEL=info
# The web side (B31b): the api and caddy (TLS, the web app). Leave it out while you only record data; when it is on,
# set DB_PASSWORD_API and APP_ENCRYPTION_KEY below, make the owner (deploy/README.md) and open 80 and 443.
#COMPOSE_PROFILES=web
# Extra compose files, relative to the repository, separated by spaces. A VM of 1 GB (the Google Cloud e2-micro) needs
# deploy/small-vm.yml: the compose file is sized for 12 GB and its database settings alone would fill 1 GB. compose.sh
# reads this line, so that deploy.sh, the timers and you over SSH all see the same stack.
#VMGS_COMPOSE_FILES=deploy/small-vm.yml

# --- the database -----------------------------------------------------------------------------------------------
# The schema owner. Read only when the database is created; only the migrate step holds it afterwards.
POSTGRES_PASSWORD=
# One password per role (the migrate step gives each role its login). DB_PASSWORD_API is needed from B29 on: the owner
# command logs in as that role (and so does the api service, B31b).
DB_PASSWORD_WORKER=
DB_PASSWORD_BACKUP=
DB_PASSWORD_API=

# --- the authentication (the api service) ------------------------------------------------------------------------
# The one secret of the login: 32 random bytes, made with  openssl rand -hex 32  and kept apart from the passwords.
# Losing or changing it makes the second step (TOTP) unreadable; owner:totp-off is the way out.
APP_ENCRYPTION_KEY=

# --- the feed and the alerts ------------------------------------------------------------------------------------
FEED_SYMBOLS=XAUUSD,DXY,XAGUSD
# From @BotFather. Without it no Telegram message is sent (the dashboard and Web Push still work).
TELEGRAM_BOT_TOKEN=
# Web Push (all three or none). A new pair and the subject line: compose.sh run --rm --no-deps -T worker node --import tsx src/cli/main.ts vapid:generate
# (the subject is a mailto: or https: address that a push service can reach you at). Then deploy.sh again; the app shows it (System, Alerts).
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=

# --- Healthchecks.io (free Hobbyist plan; one check each, with a Telegram or email alert) -----------------------------
# The worker pings this every minute while it works.
HEALTHCHECKS_PING_URL=
# The nightly backup and the monthly restore drill ping theirs (a failed run pings /fail, a missed run alerts).
HEALTHCHECKS_BACKUP_URL=
HEALTHCHECKS_DRILL_URL=

# --- backups ----------------------------------------------------------------------------------------------------
# The PUBLIC key of the age key pair that you keep OFFLINE (age-keygen on your own PC). Backups are also opened by
# the drill key of the VM (secrets/drill.key, made by vm-setup.sh), so that the drill can check them every month.
BACKUP_AGE_RECIPIENT=
# remote:bucket/path, the remote being a section of secrets/rclone.conf (see deploy/README.md). oci:... on Oracle,
# gcs:your-bucket/db on Google Cloud.
BACKUP_RCLONE_REMOTE=oci:vmgs-backups/db

# --- DuckDNS (the updater timer) ---------------------------------------------------------------------------------
DUCKDNS_DOMAIN=vmgs-yourname
DUCKDNS_TOKEN=
